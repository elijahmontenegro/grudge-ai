# Compiled binaries and their backup-suffix variants
*.exe
*.exe~*

# Local editor / tooling state
.idea/
.claude/

# Runtime artifacts
*.log
*.db
*.db-wal
*.db-shm

# Frontend node modules (if they ever get picked up by accident)
web/node_modules/
node_modules/

# Frontend build output. web/dist is the Vite output; the
# go/service/cmd/spidey/dist copy is the //go:embed source synced by the
# Taskfile's embed-sync task. Both are build artifacts.
web/dist/
go/service/cmd/spidey/dist/

# Local backups (e.g. novel-backup-* dirs from autonomous-run safety copies).
novel-backup-*/

# Python build / cache (eval/ and model/ are mixed Python research code).
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
.venv/
venv/

# Private session notes / internal planning — not for public consumption.
# Kept on disk locally for project memory but excluded from the public repo.
JOURNAL.md
docs/plan-iterations/
docs/experiments/
docs/assessment-*.md

# Taskfile build cache (regenerated on each run).
.task/

# Test fixtures for long-horizon experiments (creative seed content not
# intended for public distribution; the autonomous-loop test references
# can be reproduced locally as needed).
testdata/novel/

# Training datasets — fetched on demand by model/scripts/*; see
# model/data/README.md for the reproducible setup. ~250 MB if pulled
# locally; not bundled in the public repo.
model/data/*.jsonl
model/data/molweni/
model/data/synthetic/

# Generated proto code (gen/go) is intentionally checked in for
# external go-get consumption — see go.mod replace directives.
# When the proto module publishes, this stays committed.
